# App
ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Feast
FEAST_REPO_PATH=./feature_repo
FEAST_ONLINE_STORE_TYPE=sqlite

# DagsHub / MLflow
DAGSHUB_REPO_OWNER=<your-dagshub-username>
DAGSHUB_REPO_NAME=<your-repo-name>
MLFLOW_TRACKING_URI=https://dagshub.com/<owner>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<your-dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>
MLFLOW_EXPERIMENT_CHURN=churn_classification
MLFLOW_EXPERIMENT_LTV=ltv_regression
MODEL_NAME_CHURN=churn_model
MODEL_NAME_LTV=ltv_model
MODEL_ALIAS=champion

# Business thresholds
CHURN_RISK_HIGH_THRESHOLD=0.7
CHURN_RISK_MEDIUM_THRESHOLD=0.4
LTV_HIGH_THRESHOLD=1440.63

# Serving
PREDICTIONS_DB_PATH=predictions_log.db
API_BASE_URL=http://localhost:8000

# DVC remote (optional if same as DagsHub)
DVC_REMOTE_URL=https://dagshub.com/<owner>/<repo>.dvc

# Docker Hub (set real values in GitHub Actions secrets only)
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# CI also needs secrets: DAGSHUB_REPO_OWNER, DAGSHUB_REPO_NAME, DAGSHUB_TOKEN
